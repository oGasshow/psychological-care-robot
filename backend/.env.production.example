APP_ENV=production
SECRET_KEY=
DATABASE_URL=sqlite:////var/lib/xinyi/xinyi.db
SQLITE_BUSY_MS=1000
MODELSCOPE_API_KEY=
ROBOT_UPLOAD_POLICY=after_close
ROBOT_CARE_ANALYSIS_ENGINE=rules
ROBOT_CARE_ASSESSMENT_PROVIDER=disabled
ROBOT_CARE_SIMULATOR_ENABLED=false
ROBOT_CARE_LEASE_SECONDS=30
ROBOT_CARE_MAX_ATTEMPTS=3
ROBOT_CARE_RETRY_SECONDS=2
ROBOT_CARE_POLICY_SECONDS=3600
ROBOT_CARE_POLL_SECONDS=1
# If enabling ollama, set all required values before starting API AND worker.
# Use a lease longer than the configured model timeout plus commit overhead.
# ROBOT_CARE_ANALYSIS_ENGINE=ollama
# ROBOT_CARE_MODEL_BASE_URL=
# ROBOT_CARE_MODEL_NAME=
# ROBOT_CARE_MODEL_TIMEOUT_SECONDS=10
# ROBOT_CARE_MODEL_MAX_RESPONSE_BYTES=65536

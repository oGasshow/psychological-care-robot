# Only tools/demo_care.py prepares dedicated virtual data. Generate local secrets.
APP_ENV=development
SECRET_KEY=
DATABASE_URL=sqlite:///C:/replace-with-dedicated-demo/demo.db
SQLITE_BUSY_MS=1000

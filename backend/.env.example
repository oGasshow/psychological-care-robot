# 环境变量配置文件
# 复制此文件为 .env 并填入真实的 API Key

# ModelScope API Key（用于云端大模型）
# 获取方式：访问 https://www.modelscope.cn/my/myaccesstoken 创建 API Token
MODELSCOPE_API_KEY=your_api_key_here

# 数据库配置（可选）
DATABASE_URL=sqlite:///./data/xinyi.db

# JWT 密钥（必填，至少32字符；可用 secrets.token_urlsafe(48) 生成）
# 此处仅为占位符，部署时通过本地 .env 或进程环境提供自己的值。
SECRET_KEY=replace-this-placeholder-with-your-own-random-secret

# SQLite 每个连接的锁等待毫秒数
SQLITE_BUSY_MS=1000

# 文本客户端（与后端为不同运行进程）；不要把 ROBOT_TOKEN 写入队列或提交Git。
# ROBOT_BASE_URL=http://127.0.0.1:8000
# ROBOT_OUTBOX_PATH=./runtime/outbox.db
# ROBOT_TOKEN=通过登录在进程环境中提供
# ROBOT_HTTP_TIMEOUT=5
# ROBOT_RETRY_BASE=1
# ROBOT_RETRY_CAP=60
# ROBOT_MAX_TRANSIENT=8

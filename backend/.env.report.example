# Copy the relevant settings into backend/.env or the environment used to launch
# the API. This file is a reference; the app does not load it automatically.
# No endpoint configured: reports still produce a clearly labelled rule summary.
ROBOT_CARE_REPORT_PROVIDER=disabled
ROBOT_CARE_REPORT_MODEL_BASE_URL=
ROBOT_CARE_REPORT_MODEL_NAME=
ROBOT_CARE_REPORT_API_KEY=
ROBOT_CARE_REPORT_TIMEOUT_SECONDS=25

# Ollama: provider=ollama; base=http://127.0.0.1:11434; model=<installed model>
# Qwen: provider=qwen; base=<console's compatible-mode/v1 base URL>;
#       model=<enabled Qwen model>; API key=<your local secret>
# Doubao: provider=doubao; base=https://ark.cn-beijing.volces.com/api/v3;
#         model=<enabled model/endpoint ID>; API key=<your local secret>
# Other compatible endpoint: provider=chat_completions; base=<.../v1>
# Existing Seeduplex speech entitlement: provider=doubao_realtime;
#       configure DOUBAO_VOICE_API_KEY and timeout=45; see .env.voice.example.
# Use the base URL WITHOUT /chat/completions. The server appends the route.
# qwen disables thinking with enable_thinking=false; doubao uses
# thinking.type=disabled. Verify these capabilities for the selected model.

# Copy selected fields into ignored backend/.env, then restart the API.
DOUBAO_VOICE_API_KEY=
ROBOT_CARE_VOICE_ENABLED=true
ROBOT_CARE_VOICE_MODEL=1.2.6.1
ROBOT_CARE_VOICE_NAME=zh_female_vv_uranus_bigtts
ROBOT_CARE_VOICE_SESSION_SECONDS=900
# Report generation reuses this speech entitlement via function calling.
ROBOT_CARE_REPORT_PROVIDER=doubao_realtime
ROBOT_CARE_REPORT_TIMEOUT_SECONDS=45
# Enable conditional collection after the product's purchase notice covers it.
# This is a server deployment declaration, not a per-conversation user checkbox.
ROBOT_CARE_GUIDED_SCREENING_ENABLED=false
ROBOT_CARE_PURCHASE_NOTICE_VERSION=
ROBOT_CARE_CONCERN_DETECTOR=doubao_realtime
# New concerns are reviewed after saving a call; unfinished tasks span calls.
ROBOT_CARE_CONCERN_REVIEW_MODE=post_session
# Per-user-utterance sentiment, independent of scale/concern detection.
# Requires a usable DOUBAO_VOICE_API_KEY; omit to keep the rules default.
ROBOT_CARE_ANALYSIS_ENGINE=doubao_realtime
ROBOT_CARE_SENTIMENT_TIMEOUT_SECONDS=45
# Optional exact browser origins for reverse-proxy deployments (comma separated).
# ROBOT_CARE_VOICE_ALLOWED_ORIGINS=https://your-host.example
# Optional internal API origin if ASGI server address is unavailable.
# ROBOT_CARE_VOICE_RECORD_BASE_URL=http://127.0.0.1:8000

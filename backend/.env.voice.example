# Copy selected fields into ignored backend/.env, then restart the API.
DOUBAO_VOICE_API_KEY=
ROBOT_CARE_VOICE_ENABLED=true
ROBOT_CARE_VOICE_MODEL=1.2.6.1
ROBOT_CARE_VOICE_NAME=zh_female_vv_jupiter_bigtts
ROBOT_CARE_VOICE_SESSION_SECONDS=900
# Report generation reuses this speech entitlement via function calling.
ROBOT_CARE_REPORT_PROVIDER=doubao_realtime
ROBOT_CARE_REPORT_TIMEOUT_SECONDS=45
# Optional exact browser origins for reverse-proxy deployments (comma separated).
# ROBOT_CARE_VOICE_ALLOWED_ORIGINS=https://your-host.example
# Optional internal API origin if ASGI server address is unavailable.
# ROBOT_CARE_VOICE_RECORD_BASE_URL=http://127.0.0.1:8000

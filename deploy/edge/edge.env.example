APP_ENV=production
ROBOT_CARE_DEPLOYMENT_ROLE=edge
DATABASE_URL=postgresql+psycopg://DEVICE_DB_USER:DEVICE_DB_PASSWORD@127.0.0.1:55432/robot_care
SECRET_KEY=replace-with-the-private-edge-signing-key-at-least-32-characters
ROBOT_CARE_DEMO_DATABASE=false
ROBOT_CARE_ASSESSMENT_PROVIDER=disabled
ROBOT_CARE_SIMULATOR_ENABLED=false
ROBOT_CARE_ANALYSIS_ENGINE=rules
ROBOT_CARE_VOICE_ENABLED=true
DOUBAO_VOICE_API_KEY=
ROBOT_CARE_GUIDED_SCREENING_ENABLED=true
ROBOT_CARE_PURCHASE_NOTICE_VERSION=replace-with-your-product-notice-version
ROBOT_CARE_CONCERN_REVIEW_MODE=post_session
ROBOT_CARE_REPORT_PROVIDER=disabled
# Enable only after CPU/ARM inference and extraction have been validated.
# ROBOT_CARE_SEGA_PYTHON=/opt/robot-care-edge/runtime/sega-env/bin/python
# ROBOT_CARE_SEGA_REFERENCE=/opt/robot-care-edge/runtime/sega_reference
# ROBOT_CARE_SEGA_EXTRACTOR_CONFIG=/etc/robot-care-edge/sega-extractor.json
